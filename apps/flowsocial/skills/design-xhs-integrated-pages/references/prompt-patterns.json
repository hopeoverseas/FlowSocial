{
  "schemaVersion": "1.0",
  "library": "PagePromptPatternLibrary",
  "contentPolicy": "structure_only_no_facts_numbers_capabilities_or_cta",
  "entries": [
    {"id":"pattern.hierarchy.promise-focus","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["cover.promise"],"purpose":"建立清晰首屏焦点"},"instruction":"围绕本页主题建立一个主要阅读焦点；文字、场景、物件或抽象视觉都可成为焦点，不规定固定比例或位置。","failureModes":["多个焦点互相争夺","固定模板压过内容"],"remediation":["围绕主题重建单一阅读入口"]},
    {"id":"pattern.hierarchy.thumbnail-legibility","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["cover.promise","summary.cta"],"purpose":"保证缩略图可理解"},"instruction":"缩略图状态仍能辨认主题和主要阅读入口；形状、留白与文字尺度根据内容自行组织。","failureModes":["缩略图主题不可辨"],"remediation":["减少次要元素或更换视觉概念"]},
    {"id":"pattern.list.equal-cards","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["list.key-points"],"purpose":"并列同权要点"},"instruction":"按输入项数量生成同权分组，不增加或合并项目。","failureModes":["卡片数量漂移"],"remediation":["按真值数量重新分组"]},
    {"id":"pattern.list.priority-ladder","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["list.key-points"],"purpose":"表达输入已有优先顺序"},"instruction":"仅在输入明确有序时用尺度或位置表达先后。","failureModes":["擅自排序"],"remediation":["改用同权卡片"]},
    {"id":"pattern.process.numbered-spine","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["process.vertical-steps"],"purpose":"稳定呈现步骤顺序"},"instruction":"沿单一纵向轴放置原样步骤，序号只对应输入顺序。","failureModes":["步骤错序"],"remediation":["锁定序号并确定性回退"]},
    {"id":"pattern.process.phase-bands","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["process.vertical-steps"],"purpose":"区分输入已有阶段"},"instruction":"用背景带区分阶段，不补充阶段名称或结果。","failureModes":["生成额外阶段"],"remediation":["删除无来源分区"]},
    {"id":"pattern.compare.mirrored-columns","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["comparison.before-after"],"purpose":"中性双栏比较"},"instruction":"两栏使用镜像网格，文字逐项来自真值。","failureModes":["单栏被视觉夸大"],"remediation":["恢复等宽等权"]},
    {"id":"pattern.compare.delta-emphasis","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["comparison.before-after"],"purpose":"突出输入明确说明的差异"},"instruction":"只强调已在文字中出现的差异，不增加箭头含义。","failureModes":["夸大结果"],"remediation":["移除强化图形"]},
    {"id":"pattern.map.hub-spokes","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["explanation.concept-map"],"purpose":"解释中心与要点关系"},"instruction":"中心和节点均使用锁定术语，连接只表示输入已有归属。","failureModes":["新增关系"],"remediation":["删除无来源连接"]},
    {"id":"pattern.map.layered-system","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["explanation.concept-map"],"purpose":"呈现输入已有层级"},"instruction":"按输入层级从核心到外围分组，不推断上下游。","failureModes":["层级被误作因果"],"remediation":["改用无箭头分组"]},
    {"id":"pattern.summary.key-takeaway","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["summary.cta"],"purpose":"收束单一结论"},"instruction":"重复展示已冻结总结，不生成新结论。","failureModes":["总结被扩写"],"remediation":["恢复原样文字"]},
    {"id":"pattern.cta.single-action","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["summary.cta"],"purpose":"呈现唯一冻结 CTA"},"instruction":"仅在输入存在 CTA 时设置一个行动区并逐字保留。","failureModes":["补写关注咨询"],"remediation":["移除非输入 CTA"]},
    {"id":"pattern.asset.evidence-frame","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["list.key-points","comparison.before-after","explanation.concept-map"],"purpose":"容纳授权证据资产"},"instruction":"为已授权资产保留独立框位，不抄写资产内未冻结文字。","failureModes":["资产文字成为新事实"],"remediation":["移除资产或遮蔽非授权内容"]},
    {"id":"pattern.density.progressive-disclosure","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["list.key-points","process.vertical-steps","explanation.concept-map"],"purpose":"在中等密度下分层阅读"},"instruction":"保持全部真值可见，用视觉分组建立阅读顺序。","failureModes":["缩小文字以容纳全部内容"],"remediation":["拆页或确定性回退"]},
    {"id":"pattern.fallback.precision-first","schemaVersion":"1.0","source":{"kind":"flowsocial_original","workItem":"FS-V1-XHS-VISUAL-05B","license":"FlowSocial-Proprietary-Original"},"status":"experimental","applicability":{"archetypes":["cover.promise","list.key-points","process.vertical-steps","comparison.before-after","explanation.concept-map","summary.cta"],"purpose":"能力或真值门禁失败时显式回退"},"instruction":"停止整页 Prompt 编译并返回 deterministic_layout blocker。","failureModes":["静默继续生成"],"remediation":["阻断 Provider 请求"]}
  ]
}
