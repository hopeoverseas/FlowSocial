# MiniMax text model through the Anthropic-compatible API
FLOW_MODEL_PROVIDER=MiniMax
FLOW_MODEL_BASE_URL=https://api.minimaxi.com/anthropic
FLOW_MODEL_NAME=MiniMax-M3
FLOW_MODEL_PROTOCOL=anthropic
FLOW_MODEL_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_API_KEY=

# RedFox hotspot search
FLOW_SEARCH_PROVIDER=RedFox
REDFOX_BASE_URL=https://redfox.hk
REDFOX_API_KEY=
REDFOX_DOUYIN_SEARCH_PATH=/story/api/dyData/searchArticle
REDFOX_XHS_SEARCH_PATH=/story/api/xhsUser/searchArticle
REDFOX_WECHAT_SEARCH_PATH=/story/api/gzhData/searchArticle

# Kie.ai image generation
FLOW_IMAGE_PROVIDER=Kie.ai
KIE_BASE_URL=https://api.kie.ai
KIE_API_KEY=
KIE_IMAGE_MODEL=gpt-image-2-text-to-image
KIE_IMAGE_QUALITY=basic

# Local server
# Experimental plan-only switch. Default false, non-production, and server-controlled;
# request payloads must never override it. Later Work Items wire runtime execution.
UNIFIED_CONTENT_XHS_ATOMIC_GRAPH_V1=false
PORT=4273
